{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabu-screening",
  "compatibility_date": "2026-04-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "kabu.tokyo-jp.org/*",
      "zone_name": "tokyo-jp.org"
    }
  ]
}
