{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabu-screening-all2",
  "compatibility_date": "2026-04-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "screening-all2.pages.dev/*"
    }
  ]
}
